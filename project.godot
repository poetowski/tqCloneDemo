[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player_team"
3d_physics/layer_3="enemy_team"
3d_physics/layer_4="interact"
3d_physics/layer_5="projectile"
3d_physics/layer_6="terrain"

[physics]

3d/physics_engine="Jolt Physics"

[shader_globals]

wind_strength={
"type": "float",
"value": 1.0
}
wind_direction={
"type": "vec2",
"value": Vector2(0.95, -0.3)
}
cloud_cover={
"type": "float",
"value": 0.45
}

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.05, 1)
